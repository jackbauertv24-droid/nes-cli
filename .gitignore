node_modules/

# Emulator state written by `nes-cli load`
.nes-cli-session.json

# Cartridge dumps never belong in the repository. The only exception is the
# fixture ROMs, which are our own 6502 programs built by tools/make-fixtures.js.
*.nes
!test/fixtures/*.nes
rom/
quickshare_received/

# Default output paths, anchored to the repository root so they only cover
# files dropped here by running the tool. Without the leading slash these
# would also swallow examples-*/sprites/, which is why this file used to carry
# a long list of exceptions.
/sprites/
/frames/
/animations/
/out/
/*.gif
/*.wav
/*.ansi
/screenshot*.png
/recording*.png
/state.json
